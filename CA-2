def is_safe(graph, colors, node, color):
    for neighbor in graph[node]:
        if colors[neighbor] == color:
            return False
    return True

def solve(graph, colors, node, m):
    if node == len(graph):
        return True

    for color in range(1, m + 1):
        if is_safe(graph, colors, node, color):
            colors[node] = color

            if solve(graph, colors, node + 1, m):
                return True

            colors[node] = 0

    return False

graph = [[1, 2], [0, 2], [0, 1, 3], [2]]
colors = [0] * len(graph)

if solve(graph, colors, 0, 3):
    print("Color assignment:", colors)
else:
    print("No solution exists")



